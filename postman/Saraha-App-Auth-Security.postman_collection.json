          "name": "Wrong password attempt 5 locks account",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Fifth failure locks for five minutes', () => { pm.response.to.have.status(403); pm.expect(pm.response.json().extra.retryAfterSeconds).to.be.within(1, 300); });"
                ]
              }
            }
